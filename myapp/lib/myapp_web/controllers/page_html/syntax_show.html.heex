<Layouts.app flash={@flash}>
<main class="min-h-screen bg-[radial-gradient(circle_at_15%_5%,#ccfbf1,transparent_35%),radial-gradient(circle_at_85%_0%,#ede9fe,transparent_35%),linear-gradient(180deg,#f8fafc,#ffffff)] px-4 py-10 sm:px-8 lg:px-12">
  <section class="mx-auto max-w-5xl">
    <div class="rounded-3xl border border-teal-100 bg-white/90 p-6 shadow-lg sm:p-10">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-teal-700">
        Step {@lesson.step}/{@total_lessons}
      </p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">
        {@lesson.title}
      </h1>
      <p class="mt-4 text-sm leading-7 text-slate-700 sm:text-base">{@lesson.summary}</p>
    </div>

    <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900">学習ポイント</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-slate-700">
        <%= for goal <- @lesson.goals do %>
          <li>{goal}</li>
        <% end %>
      </ul>
    </section>

    <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900">用語と概念</h2>
      <div class="mt-4 space-y-3">
        <%= for item <- @lesson.concepts do %>
          <article class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <h3 class="text-sm font-bold text-slate-900">{item.term}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.concept}</p>
            <p class="mt-2 text-sm leading-6 text-slate-600">{item.detail}</p>
            <pre
              class="mt-2 overflow-x-auto rounded-lg bg-slate-950 p-3 text-xs leading-6 text-cyan-200"
              phx-no-curly-interpolation
            ><code><%= item.example %></code></pre>
          </article>
        <% end %>
      </div>
    </section>

    <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900">コード例</h2>
      <pre
        class="mt-4 overflow-x-auto rounded-xl bg-slate-950 p-4 text-xs leading-6 text-cyan-200"
        phx-no-curly-interpolation
      ><code><%= @lesson.snippet %></code></pre>
    </section>

    <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900">コード解説</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-slate-700">
        <%= for line <- @lesson.walkthrough do %>
          <li>{line}</li>
        <% end %>
      </ul>
    </section>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap gap-2">
        <.button :if={@previous_lesson} navigate={~p"/learn/syntax/#{@previous_lesson.id}"}>
          ← 前のレッスン
        </.button>
        <.button navigate={~p"/learn/syntax"}>一覧へ戻る</.button>
      </div>
      <div>
        <.button
          :if={@next_lesson}
          navigate={~p"/learn/syntax/#{@next_lesson.id}"}
          variant="primary"
        >
          次のレッスン →
        </.button>
      </div>
    </div>
  </section>
</main>
</Layouts.app>
