<Layouts.flash_group flash={@flash} />

<main class="min-h-screen bg-[radial-gradient(circle_at_10%_0%,#fef3c7,transparent_35%),radial-gradient(circle_at_90%_10%,#dbeafe,transparent_40%),linear-gradient(180deg,#f8fafc,#ffffff)] px-4 py-10 sm:px-8 lg:px-12">
  <section class="mx-auto max-w-6xl">
    <div class="rounded-3xl border border-amber-100 bg-white/90 p-6 shadow-lg sm:p-10">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-amber-600">
        Elixir Syntax Roadmap
      </p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">
        Elixir 基本文法コース
      </h1>
      <p class="mt-4 max-w-3xl text-sm leading-7 text-slate-700 sm:text-base">
        この一覧を上から順番に進めるだけで、Elixir の基本文法を一通り学べます。
        各ページに短いコード例と練習ポイントを置いています。
      </p>

      <div class="mt-5 flex flex-wrap gap-2">
        <.button navigate={~p"/learn"}>学習ラボへ戻る</.button>
        <.button navigate={~p"/learn/live"} variant="primary">LiveView ラボへ</.button>
      </div>
    </div>

    <section class="mt-8 space-y-4">
      <%= for lesson <- @lessons do %>
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-bold text-slate-900">
              Step {lesson.step}/{@total_lessons}: {lesson.title}
            </h2>
            <.button navigate={~p"/learn/syntax/#{lesson.id}"} variant="primary">
              このページを開く
            </.button>
          </div>
          <p class="mt-2 text-sm leading-6 text-slate-700">{lesson.summary}</p>
        </article>
      <% end %>
    </section>
  </section>
</main>
