<Layouts.flash_group flash={@flash} />

<main class="min-h-screen bg-[radial-gradient(circle_at_20%_10%,#faf5ff,transparent_40%),radial-gradient(circle_at_80%_20%,#ecfeff,transparent_45%),linear-gradient(180deg,#fff7ed,#ffffff)] px-4 py-10 sm:px-8 lg:px-12">
  <section class="mx-auto max-w-6xl">
    <div class="rounded-3xl border border-orange-100 bg-white/85 p-6 shadow-xl shadow-orange-100 backdrop-blur sm:p-10">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-orange-500">
            Elixir Learning Project
          </p>
          <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">
            手を動かして学ぶ Elixir + Phoenix
          </h1>
        </div>
        <div class="flex flex-wrap gap-2">
          <.button navigate={~p"/learn/syntax"}>文法コース一覧へ</.button>
          <.button navigate={~p"/learn/live"} variant="primary">LiveView 版へ</.button>
          <.button navigate={~p"/"}>トップへ戻る</.button>
        </div>
      </div>

      <p class="mt-5 max-w-3xl text-sm leading-7 text-slate-600 sm:text-base">
        このページは、Elixir の重要概念を読みながら実行結果を確認できる学習ラボです。
        実装は `Myapp.Learning` モジュールにまとまっており、関数を追加して自分だけの教材へ拡張できます。
      </p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">
          Pipeline Demo
        </p>
        <p class="mt-2 text-2xl font-bold text-slate-900">{@examples.pipeline}</p>
        <p class="mt-1 text-sm text-slate-600">`Enum.map/2` と `Enum.sum/1` の結果</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">
          Recursion Demo
        </p>
        <p class="mt-2 text-2xl font-bold text-slate-900">{@examples.recursion}</p>
        <p class="mt-1 text-sm text-slate-600">`factorial(5)` の計算結果</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">
          Pattern Match Demo
        </p>
        <p class="mt-2 text-lg font-bold text-slate-900">{@examples.pattern}</p>
        <p class="mt-1 text-sm text-slate-600">タプルから値を取り出した結果</p>
      </article>
    </div>

    <section class="mt-8 grid gap-4 lg:grid-cols-3">
      <%= for lesson <- @lessons do %>
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-lg font-semibold text-slate-900">{lesson.title}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">{lesson.description}</p>
          <pre
            class="mt-4 overflow-x-auto rounded-xl bg-slate-950 p-4 text-xs leading-6 text-cyan-200"
            phx-no-curly-interpolation
          ><code><%= lesson.snippet %></code></pre>
        </article>
      <% end %>
    </section>

    <section class="mt-8 rounded-3xl border border-cyan-100 bg-cyan-50/80 p-6 shadow-sm sm:p-8">
      <h2 class="text-2xl font-black tracking-tight text-slate-900">演習: パイプラインを試す</h2>
      <p class="mt-2 text-sm leading-6 text-slate-700">
        例: `1, 2, 3, 4` を入力すると、`map -> filter -> sum` を順に適用した結果を返します。
      </p>

      <.form
        for={@form}
        id="pipeline-form"
        action={~p"/learn/pipeline"}
        method="post"
        class="mt-5"
      >
        <.input
          field={@form[:numbers]}
          type="text"
          label="カンマ区切りの整数"
          placeholder="1, 2, 3, 4"
          class="w-full rounded-xl border border-cyan-200 bg-white px-4 py-3 text-slate-900"
          error_class="border-red-400"
        />
        <.button type="submit" variant="primary" class="mt-3">実行する</.button>
      </.form>

      <div :if={@result} class="mt-5 rounded-xl border border-slate-200 bg-white p-4">
        <%= case @result do %>
          <% {:ok, data} -> %>
            <p class="text-sm font-semibold text-emerald-700">実行成功</p>
            <p class="mt-2 text-sm text-slate-700">入力値: {Enum.join(data.numbers, ", ")}</p>
            <p class="text-sm text-slate-700">2倍: {Enum.join(data.doubled, ", ")}</p>
            <p class="text-sm text-slate-700">偶数のみ: {Enum.join(data.even_only, ", ")}</p>
            <p class="mt-2 text-base font-bold text-slate-900">合計: {data.sum}</p>
          <% {:error, message} -> %>
            <p class="text-sm font-semibold text-rose-700">入力エラー</p>
            <p class="mt-1 text-sm text-slate-700">{message}</p>
        <% end %>
      </div>
    </section>
  </section>
</main>
