<Layouts.app flash={@flash}>
  <main class="px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl space-y-4">
  <%= if @live_action == :dynamic do %>
    <section class="space-y-8">
      <div class="mx-auto max-w-7xl rounded-3xl border border-purple-200 bg-gradient-to-br from-purple-50 via-white to-pink-50 p-7">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-purple-700">
          Dynamic Dashboard
        </p>
        <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-900">ランダム更新ダッシュボード</h1>
        <p class="mt-3 text-sm leading-7 text-slate-700">
          LiveView のリアルタイム更新を体験できます。1 秒ごとに乱数と色が更新されます。
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <.button navigate={~p"/learn/live"}>LiveView 学習ラボへ</.button>
          <.button navigate={~p"/learn"}>コントローラ版へ</.button>
          <.button navigate={~p"/"} variant="primary">トップへ</.button>
        </div>
      </div>

      <div class="mx-auto grid max-w-7xl gap-4 md:grid-cols-2 lg:grid-cols-3">
        <article class="rounded-2xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Random Number</p>
          <p class="mt-2 text-5xl font-black text-slate-900"><%= @random_number %></p>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Random Color</p>
          <div class="mt-2 flex items-center justify-center gap-3">
            <div class="h-16 w-16 rounded-full border-2 border-slate-300" style={"background-color: #{@random_color}"}></div>
            <p class="text-sm font-mono text-slate-700"><%= @random_color %></p>
          </div>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Update Count</p>
          <p class="mt-2 text-5xl font-black text-purple-600"><%= @counter %></p>
        </article>
      </div>

      <div class="mx-auto grid max-w-7xl gap-4 md:grid-cols-2">
        <article class="rounded-2xl border border-emerald-200 bg-white p-6">
          <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Next Update In</p>
          <p class="mt-2 text-5xl font-black text-emerald-600"><%= format_remaining(@remaining) %></p>
          <p class="mt-1 text-sm text-slate-500">設定間隔：<%= @interval %>秒</p>
        </article>

        <article class="rounded-2xl border border-amber-200 bg-white p-6">
          <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Update Interval</p>
          <.form
            for={@interval_form}
            phx-change="set_interval"
            class="mt-4 flex items-baseline gap-2"
          >
            <.input
              field={@interval_form[:interval]}
              type="number"
              min="1"
              max="3600"
              class="w-40 text-3xl font-bold"
            />
            <span class="text-2xl font-bold text-slate-700">秒</span>
            <span class="ml-2 text-sm text-slate-500">（1〜3600 秒）</span>
          </.form>
        </article>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <.button phx-click="update_now" variant="primary">即時更新</.button>
        <.button phx-click="reset" variant="danger">リセット</.button>
        <span class="text-sm text-slate-600">
          最終更新: <%= Calendar.strftime(@last_updated, "%H:%M:%S") %>
        </span>
      </div>

      <section class="rounded-2xl border border-slate-200 bg-white p-5">
        <h2 class="text-xl font-bold text-slate-900">更新履歴（最新 100 件）</h2>
        <div class="mt-4 grid gap-2 sm:grid-cols-5 md:grid-cols-10">
          <%= for {item, idx} <- Enum.with_index(@history) do %>
            <div class="flex flex-col items-center justify-center rounded-xl border border-slate-200 bg-slate-50 p-2">
              <div class="mb-1 h-5 w-5 rounded-full border border-slate-300" style={"background-color: #{item.color}"}></div>
              <p class="text-xs font-bold text-slate-900"><%= item.number %></p>
              <p class="text-[10px] text-slate-500"><%= Calendar.strftime(item.time, "%H:%M:%S") %></p>
            </div>
          <% end %>
          <%= if length(@history) == 0 do %>
            <p class="text-sm text-slate-500">更新履歴はありません。</p>
          <% end %>
        </div>
      </section>
    </section>
  <% else %>
    <section class="space-y-8">
    <div class="rounded-3xl border border-cyan-200 bg-gradient-to-br from-cyan-50 via-white to-amber-50 p-7">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-cyan-700">
        Phoenix LiveView
      </p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-900">LiveView 学習ラボ</h1>
      <p class="mt-3 text-sm leading-7 text-slate-700">
        入力に応じて画面が即時更新される挙動を体験できます。`mount/3`、`handle_event/3`、`assign/3` が中心です。
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <.button navigate={~p"/learn/syntax"}>文法コース一覧へ</.button>
        <.button navigate={~p"/learn"}>コントローラ版へ</.button>
        <.button navigate={~p"/"} variant="primary">トップへ</.button>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-4">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Pipeline Demo</p>
        <p class="mt-1 text-2xl font-bold text-slate-900">{@examples.pipeline}</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-4">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Recursion Demo</p>
        <p class="mt-1 text-2xl font-bold text-slate-900">{@examples.recursion}</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-4">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Pattern Demo</p>
        <p class="mt-1 text-base font-bold text-slate-900">{@examples.pattern}</p>
      </article>
    </div>

    <section class="grid gap-4 lg:grid-cols-2">
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h2 class="text-xl font-bold text-slate-900">リアルタイム演習: パイプライン</h2>
        <p class="mt-2 text-sm text-slate-700">入力すると `phx-change` で即時計算されます。</p>

        <.form
          for={@live_form}
          id="live-pipeline-form"
          phx-change="validate_pipeline"
          phx-submit="run_pipeline"
          class="mt-4"
        >
          <.input
            field={@live_form[:numbers]}
            type="text"
            label="カンマ区切りの整数"
            placeholder="1, 2, 3, 4"
          />
          <.button type="submit" class="mt-3" variant="primary">確定実行</.button>
        </.form>

        <div
          :if={@pipeline_result}
          id="live-pipeline-result"
          class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-4"
        >
          <%= case @pipeline_result do %>
            <% {:ok, data} -> %>
              <p class="text-sm font-semibold text-emerald-700">実行成功</p>
              <p class="mt-2 text-sm text-slate-700">入力値: {Enum.join(data.numbers, ", ")}</p>
              <p class="text-sm text-slate-700">2倍: {Enum.join(data.doubled, ", ")}</p>
              <p class="text-sm text-slate-700">偶数のみ: {Enum.join(data.even_only, ", ")}</p>
              <p class="mt-1 text-base font-bold text-slate-900">合計: {data.sum}</p>
            <% {:error, message} -> %>
              <p class="text-sm font-semibold text-rose-700">入力エラー</p>
              <p class="mt-1 text-sm text-slate-700">{message}</p>
          <% end %>
        </div>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h2 class="text-xl font-bold text-slate-900">分岐演習: case</h2>
        <p class="mt-2 text-sm text-slate-700">値に応じて処理が切り替わる例です。</p>

        <.form for={@case_form} id="live-case-form" phx-change="run_case" class="mt-4">
          <.input
            field={@case_form[:status]}
            type="select"
            label="ステータス"
            options={[{"ok", "ok"}, {"error", "error"}, {"unknown", "unknown"}]}
          />
        </.form>

        <div id="live-case-result" class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-sm text-slate-800">{@case_result}</p>
        </div>
      </article>
    </section>

    <section class="grid gap-4 lg:grid-cols-2">
      <%= for topic <- @syntax_topics do %>
        <article class="rounded-2xl border border-slate-200 bg-white p-5">
          <h3 class="text-lg font-semibold text-slate-900">{topic.title}</h3>
          <p class="mt-2 text-sm text-slate-700">{topic.description}</p>
          <pre
            class="mt-3 overflow-x-auto rounded-xl bg-slate-950 p-4 text-xs leading-6 text-cyan-200"
            phx-no-curly-interpolation
          ><code><%= topic.snippet %></code></pre>
        </article>
      <% end %>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="text-xl font-bold text-slate-900">LiveView で見るポイント</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-slate-700">
        <li>`mount/3` で初期 `assign` を定義</li>
        <li>`handle_event/3` でイベントごとに state を更新</li>
        <li>`phx-change` で入力中のリアルタイム反映</li>
        <li>`phx-submit` で確定実行</li>
      </ul>
    </section>
    </section>
  <% end %>
    </div>
  </main>
</Layouts.app>
